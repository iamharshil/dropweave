{
  "name": "dropweave",
  "version": "1.0.7",
  "description": "Fast, anonymous peer-to-peer file transfer CLI over WebRTC. Zero-knowledge, OS-agnostic AirDrop alternative. Direct data channels, no cloud storage.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dropweave": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/cli/index.ts --outdir ./dist/cli --target node --external node-datachannel --minify && bun build ./src/index.ts --outdir ./dist --target node --external node-datachannel --minify && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-datachannel": "^0.12.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "bun-types": "latest",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "keywords": [
    "file-transfer",
    "p2p",
    "peer-to-peer",
    "webrtc",
    "cli",
    "terminal",
    "airdrop-alternative",
    "magic-wormhole",
    "zero-knowledge",
    "anonymous",
    "privacy",
    "direct-transfer",
    "file-sharing",
    "cross-platform",
    "os-agnostic",
    "data-channel",
    "backpressure",
    "sha256",
    "crockford-base32",
    "developer-tools"
  ],
  "author": "Harshil (https://github.com/iamharshil)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamharshil/dropweave.git",
    "directory": "packages/dropweave"
  },
  "homepage": "https://github.com/iamharshil/dropweave#readme",
  "bugs": {
    "url": "https://github.com/iamharshil/dropweave/issues"
  },
  "funding": "https://github.com/sponsors/iamharshil"
}
