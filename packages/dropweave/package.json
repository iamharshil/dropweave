{
  "name": "dropweave",
  "version": "1.0.1",
  "description": "Anonymous peer-to-peer file transfer CLI. Zero-knowledge. Direct WebRTC connection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dropweave": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/cli/index.ts --outdir ./dist/cli --target node --external node-datachannel && bun build ./src/index.ts --outdir ./dist --target node --external node-datachannel && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-datachannel": "^0.12.0",
    "commander": "^13.0.0",
    "chalk": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "bun-types": "latest",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "keywords": [
    "file-transfer",
    "p2p",
    "peer-to-peer",
    "webrtc",
    "cli",
    "anonymous",
    "zero-knowledge",
    "data-channel",
    "crockford-base32"
  ],
  "author": "Harshil (https://github.com/iamharshil)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamharshil/dropweave.git"
  },
  "homepage": "https://github.com/iamharshil/dropweave#readme",
  "bugs": {
    "url": "https://github.com/iamharshil/dropweave/issues"
  }
}
