{
  "name": "dropweave-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous, zero-knowledge, peer-to-peer file transfer CLI over WebRTC.",
  "workspaces": [
    "packages/dropweave",
    "apps/signaling-server"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "dev:signal": "bun run --filter signaling-server dev",
    "typecheck": "tsc --noEmit"
  },
  "trustedDependencies": [
    "node-datachannel"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "bun-types": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamharshil/dropweave.git"
  },
  "author": "Harshil (https://github.com/iamharshil)",
  "license": "MIT"
}
