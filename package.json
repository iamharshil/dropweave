{
  "name": "dropweave-monorepo",
  "version": "1.0.7",
  "private": true,
  "description": "Fast, anonymous peer-to-peer file transfer CLI over WebRTC. Zero-knowledge, OS-agnostic AirDrop alternative.",
  "workspaces": [
    "packages/dropweave",
    "apps/signaling-server"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "dev:signal": "bun run --filter signaling-server dev",
    "typecheck": "tsc --noEmit"
  },
  "trustedDependencies": [
    "node-datachannel"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "bun-types": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamharshil/dropweave.git"
  },
  "author": "Harshil (https://github.com/iamharshil)",
  "license": "GPL-3.0-or-later"
}
